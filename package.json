{
  "name": "@otelery/otelcol-lang",
  "version": "0.5.1",
  "description": "Language server for OpenTelemetry Collector configuration files.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/otelery/otelcol-lang"
  },
  "bin": {
    "otelcol-language-server": "./bin/otelcol-language-server.js"
  },
  "files": [
    "bin/",
    "editors/vscode/dist/server/",
    "editors/vscode/dist/schemas/"
  ],
  "scripts": {
    "watch": "node esbuild.js --watch",
    "compile": "node esbuild.js",
    "smoke": "node scripts/smoke.mjs",
    "smoke:stdio": "node scripts/smoke-stdio.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "^10.0.0",
    "vscode-languageserver": "^10.0.0",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.3",
    "@types/vscode": "^1.91.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "overrides": {
    "diff": "^8.0.3",
    "serialize-javascript": "^7.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
